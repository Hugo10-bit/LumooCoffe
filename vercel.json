{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/(style\\.css|app\\.js|favicon\\.ico)",
      "dest": "/$1"
    },
    {
      "src": "/(img|location_img|produk|admin)/(.*\\.(css|png|jpg|jpeg|gif|svg|ico|webp|js|woff|woff2|ttf|eot))",
      "dest": "/$1/$2"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
